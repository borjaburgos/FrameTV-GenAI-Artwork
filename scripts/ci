#!/bin/sh
# Run the repository's pinned Dagger CLI without changing a global installation.
set -eu

DAGGER_CI_VERSION=1.0.0-beta.27
DAGGER_CI_ARCHIVE_SHA256=de2a3ca569c3a955d5ce98d2c4879b67a4459c394a7e1684261ba7152bdb6865
DAGGER_CI_URL=https://dl.dagger.io/dagger/releases/1.0.0-beta.27/dagger_v1.0.0-beta.27_linux_amd64.tar.gz

dagger_ci_script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
dagger_ci_root=$(CDPATH= cd -- "$dagger_ci_script_dir/.." && pwd)
cd "$dagger_ci_root"

dagger_ci_is_pinned() {
    dagger_ci_report=$("$1" version 2>/dev/null) || return 1
    dagger_ci_reported_version=$(printf '%s\n' "$dagger_ci_report" |
        sed -nE 's/^(dagger |version:[[:space:]]*)(v?[^[:space:]]+).*/\2/p' |
        head -n 1)
    [ "${dagger_ci_reported_version#v}" = "$DAGGER_CI_VERSION" ]
}

dagger_ci_installed=$(command -v dagger || :)
if [ -n "$dagger_ci_installed" ] && dagger_ci_is_pinned "$dagger_ci_installed"; then
    exec "$dagger_ci_installed" "$@"
fi

dagger_ci_bin_dir=$dagger_ci_root/.dagger/bin
dagger_ci_local=$dagger_ci_bin_dir/dagger-$DAGGER_CI_VERSION
if [ -L "$dagger_ci_root/.dagger" ] || [ -L "$dagger_ci_bin_dir" ] || [ -L "$dagger_ci_local" ]; then
    printf '%s\n' 'Refusing a symbolic link in the project-local Dagger CLI cache.' >&2
    exit 1
fi
if [ -x "$dagger_ci_local" ] && dagger_ci_is_pinned "$dagger_ci_local"; then
    exec "$dagger_ci_local" "$@"
fi

if [ "$(uname -s)" != Linux ] || [ "$(uname -m)" != x86_64 ]; then
    printf '%s\n' 'Install Dagger 1.0.0-beta.27 for this platform and rerun scripts/ci.' >&2
    printf '%s\n' 'Automatic project-local installation currently supports Linux amd64 only.' >&2
    exit 1
fi
for dagger_ci_tool in curl sha256sum tar mktemp; do
    if ! command -v "$dagger_ci_tool" >/dev/null 2>&1; then
        printf 'Missing Dagger CLI bootstrap dependency: %s\n' "$dagger_ci_tool" >&2
        exit 1
    fi
done

umask 077
mkdir -p "$dagger_ci_bin_dir"
dagger_ci_download_dir=$(mktemp -d "$dagger_ci_bin_dir/.dagger-download.XXXXXX")
dagger_ci_cleanup() {
    rm -f -- "$dagger_ci_download_dir/dagger.tar.gz" "$dagger_ci_download_dir/dagger"
    rmdir -- "$dagger_ci_download_dir" 2>/dev/null || :
}
trap dagger_ci_cleanup EXIT
trap 'exit 1' HUP INT TERM

printf 'Preparing project-local Dagger %s from the official release archive.\n' "$DAGGER_CI_VERSION" >&2
curl --fail --silent --show-error --location --proto '=https' --proto-redir '=https' \
    --connect-timeout 15 --max-time 120 --max-redirs 3 \
    --output "$dagger_ci_download_dir/dagger.tar.gz" "$DAGGER_CI_URL"
if ! printf '%s  %s\n' "$DAGGER_CI_ARCHIVE_SHA256" "$dagger_ci_download_dir/dagger.tar.gz" |
    sha256sum --check --status; then
    printf '%s\n' 'Dagger CLI archive checksum did not match the repository pin; nothing was installed.' >&2
    exit 1
fi
tar -xzf "$dagger_ci_download_dir/dagger.tar.gz" -C "$dagger_ci_download_dir" dagger
chmod 755 "$dagger_ci_download_dir/dagger"
if ! dagger_ci_is_pinned "$dagger_ci_download_dir/dagger"; then
    printf '%s\n' 'Downloaded Dagger CLI did not report the pinned version; nothing was installed.' >&2
    exit 1
fi
mv -f -- "$dagger_ci_download_dir/dagger" "$dagger_ci_local"
dagger_ci_cleanup
trap - EXIT HUP INT TERM
exec "$dagger_ci_local" "$@"
