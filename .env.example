# Use a published GHCR tag, or leave this at frameart:local and run `make build`.
FRAMEART_IMAGE=frameart:local

# Required for LAN/container serving. If omitted, FrameArt creates a persistent
# admin token in /data/frameart/secrets/admin-api.token on first startup.
FRAMEART_AUTH_ENABLED=true
# FRAMEART_ADMIN_TOKEN=replace-with-at-least-20-random-characters
# FRAMEART_AUTOMATION_TOKEN=replace-with-a-separate-automation-token
FRAMEART_DEVICE_SESSION_DAYS=365
FRAMEART_PAIRING_CODE_MINUTES=10

# Passwordless access through `tailscale serve`; JSON array syntax is required
# for list-valued environment settings.
FRAMEART_TAILSCALE_AUTH_ENABLED=false
# FRAMEART_TAILSCALE_ALLOWED_USERS=["owner@example.com"]

# Optional no-prompt access for a fully trusted RFC1918 LAN/VLAN.
# FRAMEART_TRUSTED_LAN_CIDRS=["192.168.1.0/24"]

# Configure one or more generation providers.
# OPENAI_API_KEY=
# GOOGLE_API_KEY=
# OLLAMA_BASE_URL=http://127.0.0.1:11434

# Optional schedule event publishing (install/build frameart[integrations]).
# FRAMEART_MQTT_BROKER=192.168.1.10
# FRAMEART_MQTT_PORT=1883
# FRAMEART_MQTT_USERNAME=
# FRAMEART_MQTT_PASSWORD=
# FRAMEART_MQTT_TOPIC_PREFIX=frameart

# Used by deploy/Caddyfile.local.
FRAMEART_DOMAIN=frameart.home.arpa
