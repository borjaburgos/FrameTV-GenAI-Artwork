# Copy to a private environment file, never commit real passwords or API keys.
# Absolute directories must already exist. Docker must not create empty stand-ins.
RESOURCESPACE_DOCKER_SOURCE=/absolute/path/to/reviewed/resourcespace-docker
RESOURCESPACE_NAS_ORIGINALS=/absolute/path/to/mounted/NAS/Media/Artwork/originals
RESOURCESPACE_TV_RENDITIONS=/absolute/path/to/generated/tv-4k
RESOURCESPACE_DB_PASSWORD_FILE=/absolute/private/path/resourcespace-db-password
RESOURCESPACE_DB_ROOT_PASSWORD_FILE=/absolute/private/path/resourcespace-root-password
RESOURCESPACE_PORT=8187
# Canonical URL used by the server-side FrameArt adapter and ResourceSpace itself.
RESOURCESPACE_BASE_URL=http://127.0.0.1:8187
# Keep loopback unless a dedicated private VM address is explicitly approved.
RESOURCESPACE_BIND_ADDRESS=127.0.0.1
